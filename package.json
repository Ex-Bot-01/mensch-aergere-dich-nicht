{
  "name": "mensch-aergere-dich-nicht",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "start": "tsx apps/server/src/main.ts",
    "dev": "tsx watch apps/server/src/main.ts",
    "build": "npm run build -w @madn/web",
    "accept": "node scripts/acceptance.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "happy-dom": "^21.0.4",
    "playwright": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
